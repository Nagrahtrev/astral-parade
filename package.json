{
  "name": "astral-parade",
  "version": "1.0.0",
  "scripts": {
    "clean": "node -e \"fs.rmSync('public', { recursive: true, force: true })\"",
    "prestart": "npm run clean",
    "prebuild": "npm run clean",
    "start": "concurrently \"npm run watch\" \"npm run watch-fallback\" \"npm run dev\"",
    "dev": "node scripts/dev-server.js",
    "build": "postcss ./assets/css/main.css -o ./static/css/tailwind-build.css && node scripts/run-color-mix-fallback.js && node scripts/apply-fallback.js && hugo --gc --minify",
    "postbuild": "node scripts/submit-indexnow.mjs && node scripts/submit-baidu.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "baidu:submit": "node scripts/submit-baidu.mjs",
    "watch": "postcss ./assets/css/main.css -o ./static/css/tailwind-build.css --watch",
    "watch-fallback": "node scripts/watch-fallback.js",
    "subset": "python scripts/subset-fonts.py",
    "notion:import": "node --env-file-if-exists=.env scripts/notion-import.mjs"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "^4.0.6",
    "@notionhq/client": "^5.24.0",
    "@tailwindcss/cli": "^4.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "lightningcss": "^1.33.0",
    "notion-to-md": "^3.1.9",
    "postcss-cli": "^11.0.1",
    "postcss-lightningcss": "^1.1.0",
    "tailwindcss": "^4.2.1"
  }
}
